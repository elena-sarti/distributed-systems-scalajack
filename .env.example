# Optional: without a .env file docker-compose.yml uses defaults that are fine for local runs only.
# Changing POSTGRES_PASSWORD after the first start needs a new database: docker compose down -v
POSTGRES_DB=scalajack
POSTGRES_USER=scalajack
POSTGRES_PASSWORD=change-me
# Secret shared by lobby and tables to sign the session tokens (at least 32 characters).
# SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
